  "TutorTranslates": [
    {
      "<Id>k__BackingField": "hello",
      "name": "Salut, l'ami! Tu es arrivé dans un monde d'aventures extraordinaire! Des défis, du fun et des tonnes de pièces t'attendent ici!"
    },
    {
      "<Id>k__BackingField": "movement",
      "name": "Regarde comme c'est simple! Tu peux courir avec le joystick ou les flèches du clavier. Essaie de faire un pas en avant!"
    },
    {
      "<Id>k__BackingField": "flyExplain",
      "name": "Ton objectif principal est de voler le plus loin possible, d'éviter les pièges et de battre ton record à chaque fois!"
    },
    {
      "<Id>k__BackingField": "betZone",
      "name": "Tu vois cette zone lumineuse? Plus tu restes dessus longtemps, plus tu gagnes de pièces. On vérifie?"
    },
    {
      "<Id>k__BackingField": "x2Flight",
      "name": "Maintenant, cours vers la zone x2 - elle double tes gains."
    },
    {
      "<Id>k__BackingField": "startZone",
      "name": "Courons vers la zone de départ, l'aventure commence!"
    },
    {
      "<Id>k__BackingField": "fall",
      "name": "Oups! Tombé? Pas de souci, ça arrive! Relève-toi et réessaie - tu vas y arriver!"
    },
    {
      "<Id>k__BackingField": "success",
      "name": "Bravo! Tu as réussi! Tes premières pièces t'attendent déjà. Cours vite les récupérer!"
    },
    {
      "<Id>k__BackingField": "shield",
      "name": "Améliore ton bouclier. Tes pièces sont maintenant protégées même dans les pièges!"
    },
    {
      "<Id>k__BackingField": "petOpening",
      "name": "Et il y a aussi des compagnons géniaux et des skins super cools! Tu veux voir? Allons débloquer ton premier compagnon!"
    },
    {
      "<Id>k__BackingField": "cutePet",
      "name": "Waouh! Regarde comme il est mignon! Maintenant, il voyagera avec toi et t'aidera à gagner encore plus de pièces!"
    },
    {
      "<Id>k__BackingField": "miniGames",
      "name": "Et il y a aussi: parkour, basket-ball, trampolines et jeux musicaux! Tout au même endroit!"
    },
    {
      "<Id>k__BackingField": "rangStatus",
      "name": "Regarde l'écran: à droite - tes compétences, et en bas - ton rang. Plus tu as de pièces, plus ton statut est élevé!"
    },
    {
      "<Id>k__BackingField": "goodLuck",
      "name": "Tu es maintenant un vrai joueur! Tutoriel terminé. Cours, découvre et gagne. Bonne chance, champion!"
    }
