  CollectRewardNotification: "\u0417\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u043D\u0430\u0433\u0440\u0430\u0434\u0443"
  TaskTableTitle: "\u0417\u0430\u0434\u0430\u0447\u0438"
  TaskTranslates:
  - Type: 0
    TaskText: "\u041F\u0440\u043E\u043B\u0435\u0442\u0435\u0442\u044C {0} \u043C."
  - Type: 1
