  - Type: 2
    TaskText: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C {0} \u043C\u043E\u043D\u0435\u0442."
  - Type: 3
    TaskText: "\u041F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C {0} \u043C\u043E\u043D\u0435\u0442."
  Meters: "\u043C"
  You: "\u0412\u044B"
  TutorTranslates:
  - Id: hello
    Phrase: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0434\u0440\u0443\u0433! \u0422\u044B
      \u043F\u043E\u043F\u0430\u043B \u0432 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043C\u0438\u0440 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439!
      \u0417\u0434\u0435\u0441\u044C \u0442\u0435\u0431\u044F \u0436\u0434\u0435\u0442
      \u0432\u0435\u0441\u0435\u043B\u044C\u0435, \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F
      \u0438 \u043A\u0443\u0447\u0430 \u043C\u043E\u043D\u0435\u0442!"
  - Id: movement
    Phrase: "\u0421\u043C\u043E\u0442\u0440\u0438, \u043A\u0430\u043A \u0442\u0443\u0442
      \u0432\u0441\u0451 \u043F\u0440\u043E\u0441\u0442\u043E! \u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u0431\u0435\u0433\u0430\u0442\u044C \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u0434\u0436\u043E\u0439\u0441\u0442\u0438\u043A\u0430 \u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u043E\u0447\u0435\u043A
      \u043D\u0430 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0448\u0430\u0433 \u0432\u043F\u0435\u0440\u0451\u0434!"
  - Id: flyExplain
    Phrase: "\u0422\u0432\u043E\u044F \u0433\u043B\u0430\u0432\u043D\u0430\u044F
      \u0437\u0430\u0434\u0430\u0447\u0430 - \u043F\u0440\u043E\u043B\u0435\u0442\u0435\u0442\u044C
      \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0434\u0430\u043B\u044C\u0448\u0435,
      \u043D\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u0442\u044C\u0441\u044F \u0432
      \u043B\u043E\u0432\u0443\u0448\u043A\u0438 \u0438 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0440\u0430\u0437 \u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043D\u043E\u0432\u044B\u0439
      \u0440\u0435\u043A\u043E\u0440\u0434!"
  - Id: betZone
    Phrase: "\u0412\u0438\u0434\u0438\u0448\u044C \u044D\u0442\u0443 \u0441\u0432\u0435\u0442\u044F\u0449\u0443\u044E\u0441\u044F
      \u0437\u043E\u043D\u0443? \u0427\u0435\u043C \u0434\u043E\u043B\u044C\u0448\u0435
      \u0442\u044B \u043D\u0430 \u043D\u0435\u0439 \u0441\u0442\u043E\u0438\u0448\u044C,
      \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u043C\u043E\u043D\u0435\u0442
      \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C \u0432 \u043D\u0430\u0433\u0440\u0430\u0434\u0443.
      \u0414\u0430\u0432\u0430\u0439 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C?"
  - Id: x2Flight
    Phrase: "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0431\u0435\u0433\u0438
      \u0432 \u0437\u043E\u043D\u0443 x2 - \u043E\u043D\u0430 \u0443\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442
      \u0442\u0432\u043E\u0439 \u0432\u044B\u0438\u0433\u0440\u044B\u0448."
  - Id: startZone
    Phrase: "\u041F\u043E\u0431\u0435\u0436\u0430\u043B\u0438 \u043D\u0430 \u0437\u043E\u043D\u0443
      \u0441\u0442\u0430\u0440\u0442\u0430, \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u043C
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435!"
  - Id: fall
    Phrase: "\u041E\u0439! \u0423\u043F\u0430\u043B? \u041D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439,
      \u0442\u0430\u043A \u0431\u044B\u0432\u0430\u0435\u0442! \u0412\u0441\u0442\u0430\u0432\u0430\u0439
      \u0438 \u043F\u0440\u043E\u0431\u0443\u0439 \u0441\u043D\u043E\u0432\u0430
      - \u0443 \u0442\u0435\u0431\u044F \u0432\u0441\u0451 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F!"
  - Id: success
    Phrase: "\u0423\u0440\u0430! \u0422\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F!
      \u0422\u0432\u043E\u0438 \u043F\u0435\u0440\u0432\u044B\u0435 \u043C\u043E\u043D\u0435\u0442\u044B
      \u0443\u0436\u0435 \u0436\u0434\u0443\u0442 \u0442\u0435\u0431\u044F. \u0411\u0435\u0433\u0438
      \u0441\u043A\u043E\u0440\u0435\u0435 \u0437\u0430\u0431\u0438\u0440\u0430\u0442\u044C
      \u043D\u0430\u0433\u0440\u0430\u0434\u0443!"
  - Id: shield
    Phrase: "\u041F\u0440\u043E\u043A\u0430\u0447\u0430\u0439 \u0449\u0438\u0442.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u043D\u0435\u0442\u044B \u0432
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u0434\u0430\u0436\u0435
      \u0432 \u043B\u043E\u0432\u0443\u0448\u043A\u0430\u0445!"
  - Id: petOpening
    Phrase: "\u0410 \u0435\u0449\u0451 \u0437\u0434\u0435\u0441\u044C \u0436\u0438\u0432\u0443\u0442
      \u043A\u043B\u0430\u0441\u0441\u043D\u044B\u0435 \u043F\u0438\u0442\u043E\u043C\u0446\u044B
      \u0438 \u043A\u0440\u0443\u0442\u044B\u0435 \u0441\u043A\u0438\u043D\u044B!
      \u0425\u043E\u0447\u0435\u0448\u044C \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C?
      \u0414\u0430\u0432\u0430\u0439 \u043E\u0442\u043A\u0440\u043E\u0435\u043C \u0442\u0432\u043E\u0435\u0433\u043E
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0434\u0440\u0443\u0436\u043A\u0430!"
  - Id: cutePet
    Phrase: "\u0412\u0430\u0443! \u0421\u043C\u043E\u0442\u0440\u0438, \u043A\u0430\u043A\u043E\u0439
      \u043C\u0438\u043B\u044B\u0439! \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u043D
      \u0431\u0443\u0434\u0435\u0442 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0441 \u0442\u043E\u0431\u043E\u0439 \u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C
      \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C \u0435\u0449\u0451
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043C\u043E\u043D\u0435\u0442!"
  - Id: miniGames
    Phrase: "\u0410 \u0435\u0449\u0451 \u0442\u0443\u0442: \u043F\u0430\u0440\u043A\u0443\u0440,
      \u0431\u0430\u0441\u043A\u0435\u0442\u0431\u043E\u043B, \u0431\u0430\u0442\u0443\u0442\u044B
      \u0438 \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u044B\u0435 \u0438\u0433\u0440\u044B!
      \u0412\u0441\u0451 \u0432 \u043E\u0434\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435!"
  - Id: rangStatus
    Phrase: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u044D\u043A\u0440\u0430\u043D:
      \u0441\u043F\u0440\u0430\u0432\u0430 - \u0442\u0432\u043E\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438,
      \u0430 \u0441\u043D\u0438\u0437\u0443 \u2014 \u0442\u0432\u043E\u0439 \u0440\u0430\u043D\u0433.
      \u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u043C\u043E\u043D\u0435\u0442,
      \u0442\u0435\u043C \u043A\u0440\u0443\u0447\u0435 \u0442\u0432\u043E\u0439
      \u0441\u0442\u0430\u0442\u0443\u0441!"
  - Id: goodLuck
    Phrase: "\u0422\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u0438\u0433\u0440\u043E\u043A! \u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435
      \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043E. \u0411\u0435\u0433\u0438
      \u0432\u043F\u0435\u0440\u0451\u0434, \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0439
      \u043D\u043E\u0432\u043E\u0435 \u0438 \u0432\u044B\u0438\u0433\u0440\u044B\u0432\u0430\u0439.
      \u0423\u0434\u0430\u0447\u0438, \u0447\u0435\u043C\u043F\u0438\u043E\u043D!"
