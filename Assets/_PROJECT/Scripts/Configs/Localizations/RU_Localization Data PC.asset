  TaskTranslates:
  - Type: 0
    TaskText: "\u041F\u0440\u043E\u043B\u0435\u0442\u0435\u0442\u044C {0} \u043C."
  - Type: 1
    TaskText: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C {0} \u0431\u0443\u0441\u0442\u043E\u0432."
  - Type: 2
    TaskText: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C {0} \u043C\u043E\u043D\u0435\u0442."
  - Type: 3
    TaskText: "\u041F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C {0} \u043C\u043E\u043D\u0435\u0442."
  TutorTranslates:
  - Id: 0
    Phrase: "\u041F\u0440\u0438\u0432\u0435\u0442! \u0421\u0435\u0439\u0447\u0430\u0441
      \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443 \u043A\u0430\u043A \u0432\u0441\u0435
      \u0442\u0443\u0442 \u0443\u0441\u0442\u0440\u043E\u0435\u043D\u043E"
  - Id: 1
    Phrase: "\u0423 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439
      \u043A\u0430\u043F\u0438\u0442\u0430\u043B. \u041E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u043E\u043A \u0432 \u0438\u0433\u0440\u0435
      \u043F\u0440\u0438\u0443\u043C\u043D\u043E\u0436\u0435\u043D\u0438\u0435 \u0441\u0442\u0430\u0432\u043A\u0438."
  - Id: 2
    Phrase: "\u041F\u043E\u0448\u043B\u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043C
      \u0434\u0435\u043D\u044C\u0433\u0438, \u0447\u0435\u043C \u0434\u043E\u043B\u044C\u0448\u0435
      \u0441\u0442\u043E\u0438\u0448\u044C \u0432 \u044D\u0442\u043E\u0439 \u0437\u043E\u043D\u0435
      \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u0442\u0430\u0432\u043A\u0430 "
  - Id: 3
    Phrase: "\u041F\u043E\u0448\u043B\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u043C
      \u043D\u0430\u0448 \u0432\u044B\u0438\u0433\u0440\u044B\u0448\u044C \u0432
      2 \u0440\u0430\u0437\u0430, \u043D\u043E \u0447\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435
      \u043C\u043D\u043E\u0436\u0438\u0442\u0435\u043B\u044C \u0432\u044B\u0438\u0433\u0440\u044B\u0448\u0430
      \u0442\u0435\u043C \u0434\u0430\u043B\u044C\u0448\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435  "
  - Id: 4
    Phrase: "\u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u043B\u0435\u0442\u0435\u043B\u0438!
      \u0411\u0435\u0433\u0438 \u0432 \u0437\u043E\u043D\u0443 \u0441\u0442\u0430\u0440\u0442\u0430"
  - Id: 5
    Phrase: "\u0414\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B
      \u0434\u043E\u043B\u0435\u0442\u0435\u0442\u044C \u0442\u044B \u0434\u043E\u043B\u0436\u0435\u043D
      \u043B\u043E\u0432\u0438\u0442\u044C \u0431\u0443\u0441\u0442\u044B \u0438
      \u0443\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      \u043E\u0442 \u043B\u043E\u0432\u0443\u0448\u0435\u043A. "
  - Id: 6
    Phrase: "\u0422\u0432\u043E\u044F \u0446\u0435\u043B\u044C - \u043A\u0440\u0435\u0439\u0441\u0435\u0440.
      \u0423\u0434\u0430\u0447\u0438 ! "
  - Id: 7
    Phrase: "\u041C\u043E\u043B\u043E\u0434\u0435\u0446, \u043F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E
      \u0441 \u0432\u044B\u0438\u0433\u0440\u044B\u0448\u0435\u043C ! \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F
      \u043D\u0430 \u0441\u043F\u0430\u0432\u043D. "
  - Id: 8
    Phrase: "\u041F\u043E\u0448\u043B\u0438 \u0437\u0430\u0431\u0435\u0440\u0435\u043C
      \u0432\u044B\u0438\u0433\u0440\u044B\u0448\u044C \u0437\u0430 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0435
      \u0437\u0430\u0434\u0430\u043D\u0438\u044F ! "
  - Id: 9
    Phrase: "\u0412 \u0438\u0433\u0440\u0435 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u0442\u044C
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430, \u043F\u043E\u0448\u043B\u0438
      \u043F\u0440\u043E\u043A\u0430\u0447\u0430\u0435\u043C \u0432\u044B\u0438\u0433\u0440\u044B\u0448\u044C
      \u0437\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044E. "
  - Id: 10
    Phrase: "\u041D\u0430 \u043C\u0438\u043D\u0438 \u0438\u0433\u0440\u0430\u0445
      \u0442\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C,
      \u0443\u0434\u0430\u0447\u0438 ! "
